/* =========================================================
   OLATEE
   Main Storefront Styles
========================================================= */

html {
    color-scheme: light;
    scroll-behavior: smooth;
}

:root {
    --cream: #fffaf7;
    --white: #ffffff;
    --blush: #f8e7eb;
    --pink: #e9aab8;
    --pink-dark: #c8758b;
    --plum: #5d3045;
    --text: #33242b;
    --muted: #806e75;
    --border: #eadde0;

    --container: 1240px;
    --radius: 4px;
    --shadow: 0 18px 50px rgba(93, 48, 69, 0.10);
}


/* =========================================================
   RESET
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: var(--cream);
    color: var(--text);
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    line-height: 1.6;
}

img {
    display: block;
    max-width: 100%;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================================================
   ACCESSIBILITY
========================================================= */

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}


/* =========================================================
   HEADER
========================================================= */

.site-header {
    position: relative;
    z-index: 20;
    background: rgba(255, 250, 247, 0.96);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    width: min(100% - 48px, var(--container));
    min-height: 82px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}


/* BRAND */

.brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
}

.brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
}

.brand-mark svg {
    width: 100%;
    height: 100%;
    fill: var(--pink-dark);
    stroke: var(--pink-dark);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.brand-name {
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -1px;
}


/* NAVIGATION */

.main-nav {
    display: flex;
    align-items: center;
    gap: 34px;
}

.main-nav a {
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    transition: color 0.2s ease;
}

.main-nav a:hover {
    color: var(--pink-dark);
}


/* HEADER ACTIONS */

.header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.icon-button,
.cart-button,
.menu-button {
    border: 0;
    background: transparent;
}

.icon-button,
.cart-button {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    position: relative;
}

.icon-button svg,
.cart-button svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: var(--text);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.cart-count {
    position: absolute;
    top: 2px;
    right: 1px;

    min-width: 17px;
    height: 17px;

    padding: 0 4px;

    border-radius: 20px;

    display: grid;
    place-items: center;

    background: var(--plum);
    color: white;

    font-size: 10px;
    font-weight: 700;
}

.menu-button {
    display: none;
    width: 42px;
    height: 42px;
}

.menu-button span {
    display: block;
    width: 22px;
    height: 1.5px;
    margin: 5px auto;
    background: var(--text);
}


/* =========================================================
   HERO
========================================================= */

.hero {
    width: min(100% - 48px, var(--container));
    min-height: 650px;
    margin: auto;

    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: 70px;
}

.hero-content {
    padding: 70px 0;
}

.eyebrow {
    display: inline-block;
    margin-bottom: 16px;

    color: var(--pink-dark);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.hero h1 {
    max-width: 650px;

    color: var(--plum);

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -3px;
}

.hero h1 em {
    color: var(--pink-dark);
    font-style: italic;
}

.hero p {
    max-width: 510px;
    margin-top: 26px;

    color: var(--muted);
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
}


/* BUTTONS */

.btn {
    min-height: 50px;
    padding: 0 25px;

    border: 1px solid transparent;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 13px;
    font-weight: 700;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--plum);
    color: white;
}

.btn-primary:hover {
    background: var(--pink-dark);
}

.btn-outline {
    border-color: var(--border);
    background: white;
    color: var(--plum);
}

.btn-outline:hover {
    border-color: var(--pink);
}

.btn-light {
    background: white;
    color: var(--plum);
}


/* HERO VISUAL */

.hero-visual {
    min-height: 560px;
    position: relative;

    display: grid;
    place-items: center;
}

.hero-shape {
    position: absolute;
    width: 75%;
    height: 88%;

    background: var(--blush);

    border-radius: 48% 52% 42% 58% / 55% 44% 56% 45%;

    transform: rotate(-5deg);
}

.hero-image-placeholder {
    position: relative;
    z-index: 2;

    width: 68%;
    height: 78%;

    background:
        linear-gradient(
            145deg,
            #f1cbd3,
            #e6a9b7
        );

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    color: white;

    box-shadow: var(--shadow);
}

.hero-image-placeholder span {
    font-family: Georgia, serif;
    font-size: 52px;
    letter-spacing: 4px;
}

.hero-image-placeholder small {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
}


/* FLOATING CARD */

.floating-card {
    position: absolute;
    z-index: 3;
    left: 2%;
    bottom: 13%;

    min-width: 150px;
    padding: 18px;

    background: white;
    box-shadow: var(--shadow);
}

.floating-label {
    display: block;
    margin-bottom: 5px;

    color: var(--pink-dark);

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card strong {
    color: var(--plum);
    font-size: 14px;
}

.floating-card small {
    margin-top: 2px;
    color: var(--muted);
    font-size: 11px;
}


/* =========================================================
   TRUST STRIP
========================================================= */

.trust-strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);

    background: white;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.trust-strip > div {
    min-height: 100px;
    padding: 20px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    border-right: 1px solid var(--border);
}

.trust-strip > div:last-child {
    border-right: 0;
}

.trust-strip strong {
    color: var(--plum);
    font-size: 13px;
}

.trust-strip span {
    color: var(--muted);
    font-size: 11px;
}


/* =========================================================
   GENERAL SECTIONS
========================================================= */

.section {
    width: min(100% - 48px, var(--container));
    margin: auto;
    padding: 100px 0;
}

.section-heading {
    margin-bottom: 38px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
}

.section-heading .eyebrow {
    margin-bottom: 8px;
}

.section-heading h2,
.newsletter h2,
.promotion h2 {
    color: var(--plum);

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -1.5px;
}

.text-link {
    color: var(--pink-dark);
    font-size: 13px;
    font-weight: 700;
}

.text-link:hover {
    text-decoration: underline;
}


/* =========================================================
   CATEGORIES
========================================================= */

.category-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: 270px 270px;
    gap: 16px;
}

.category-card {
    position: relative;
    overflow: hidden;

    background: var(--blush);
}

.category-large {
    grid-row: span 2;
}

.category-image {
    width: 100%;
    height: 100%;

    display: grid;
    place-items: center;

    background: linear-gradient(145deg, #f1d0d7, #e6a9b7);

    color: white;
}

.category-image.pixie {
    background: linear-gradient(145deg, #ead4d8, #d8b1ba);
}

.category-image.bouncy {
    background: linear-gradient(145deg, #efd9cc, #dfb69f);
}

.category-image.straight {
    background: linear-gradient(145deg, #e8dce0, #cfaeb9);
}

.category-image span {
    font-family: Georgia, serif;
    font-size: 28px;
    letter-spacing: 3px;
    opacity: 0.8;
}

.category-info {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;

    padding: 16px;

    background: rgba(255, 255, 255, 0.94);
}

.category-info h3 {
    color: var(--plum);
    font-family: Georgia, serif;
    font-size: 20px;
    font-weight: 500;
}

.category-info span {
    color: var(--pink-dark);
    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   PRODUCTS
========================================================= */

.products-section {
    padding-top: 20px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.product-card {
    min-width: 0;
}

.product-image {
    position: relative;

    aspect-ratio: 0.82;

    display: grid;
    place-items: center;

    overflow: hidden;

    background: var(--blush);
}

.product-placeholder {
    color: rgba(93, 48, 69, 0.35);

    font-family: Georgia, serif;
    font-size: 16px;
    letter-spacing: 3px;
}

.product-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;

    padding: 6px 9px;

    background: white;
    color: var(--pink-dark);

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}

.product-details {
    padding-top: 15px;

    display: flex;
    justify-content: space-between;
    gap: 15px;
}

.product-details h3 {
    color: var(--plum);
    font-family: Georgia, serif;
    font-size: 17px;
    font-weight: 500;
}

.product-details p {
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
}

.product-details strong {
    color: var(--plum);
    font-size: 13px;
    white-space: nowrap;
}


/* =========================================================
   PROMOTION
========================================================= */

.promotion {
    position: relative;
    overflow: hidden;

    min-height: 440px;

    padding: 80px max(24px, calc((100vw - var(--container)) / 2));

    background: var(--plum);

    display: flex;
    align-items: center;
}

.promotion-content {
    position: relative;
    z-index: 2;
    max-width: 560px;
}

.promotion .eyebrow {
    color: var(--pink);
}

.promotion h2 {
    color: white;
}

.promotion p {
    max-width: 450px;
    margin: 22px 0 30px;

    color: #e9dce1;
    font-size: 15px;
}

.promotion-decoration {
    position: absolute;
    right: 8%;
    top: 50%;
    transform: translateY(-50%);

    width: 390px;
    height: 390px;

    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;

    display: grid;
    place-items: center;
}

.promotion-decoration::before,
.promotion-decoration::after {
    content: "";
    position: absolute;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
}

.promotion-decoration::before {
    width: 290px;
    height: 290px;
}

.promotion-decoration::after {
    width: 190px;
    height: 190px;
}

.promotion-decoration span {
    color: rgba(255, 255, 255, 0.12);

    font-family: Georgia, serif;
    font-size: 170px;
}


/* =========================================================
   NEWSLETTER
========================================================= */

.newsletter {
    width: min(100% - 48px, var(--container));
    margin: auto;
    padding: 90px 0;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.newsletter h2 {
    font-size: 38px;
}

.newsletter p {
    max-width: 520px;
    margin-top: 15px;

    color: var(--muted);
    font-size: 14px;
}

.newsletter-form {
    display: flex;
    gap: 8px;
}

.newsletter-form input {
    min-width: 0;
    flex: 1;

    height: 50px;
    padding: 0 17px;

    border: 1px solid var(--border);
    outline: none;

    background: white;
    color: var(--text);
}

.newsletter-form input:focus {
    border-color: var(--pink);
}


/* =========================================================
   FOOTER
========================================================= */

.site-footer {
    padding: 70px 0 25px;

    background: white;
    border-top: 1px solid var(--border);
}

.footer-inner {
    width: min(100% - 48px, var(--container));
    margin: auto;

    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 50px;
}

.footer-brand p {
    margin-top: 15px;
    color: var(--muted);
    font-size: 13px;
}

.footer-column {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.footer-column h3 {
    margin-bottom: 8px;

    color: var(--plum);

    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.footer-column a {
    width: fit-content;

    color: var(--muted);
    font-size: 12px;
}

.footer-column a:hover {
    color: var(--pink-dark);
}

.footer-bottom {
    width: min(100% - 48px, var(--container));
    margin: 55px auto 0;
    padding-top: 20px;

    display: flex;
    justify-content: space-between;

    border-top: 1px solid var(--border);

    color: var(--muted);
    font-size: 10px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

    .main-nav {
        display: none;
    }

    .menu-button {
        display: block;
    }

    .hero {
        grid-template-columns: 1fr;
        gap: 20px;
        padding-top: 30px;
    }

    .hero-content {
        padding: 50px 0 20px;
    }

    .hero-visual {
        min-height: 500px;
    }

    .category-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 300px 300px;
    }

    .category-large {
        grid-row: span 1;
    }

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 40px;
    }

    .newsletter {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .footer-inner {
        grid-template-columns: 1fr 1fr;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .header-inner,
    .hero,
    .section,
    .newsletter,
    .footer-inner,
    .footer-bottom {
        width: min(100% - 30px, var(--container));
    }

    .header-inner {
        min-height: 70px;
    }

    .brand-name {
        font-size: 25px;
    }

    .hero {
        min-height: auto;
    }

    .hero-content {
        padding: 45px 0 15px;
    }

    .hero h1 {
        font-size: 49px;
        letter-spacing: -2px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-visual {
        min-height: 400px;
    }

    .hero-image-placeholder {
        width: 75%;
        height: 76%;
    }

    .hero-image-placeholder span {
        font-size: 35px;
    }

    .floating-card {
        left: 0;
        bottom: 7%;
    }

    .trust-strip {
        grid-template-columns: 1fr 1fr;
    }

    .trust-strip > div {
        min-height: 90px;
    }

    .trust-strip > div:nth-child(2) {
        border-right: 0;
    }

    .trust-strip > div:nth-child(-n + 2) {
        border-bottom: 1px solid var(--border);
    }

    .section {
        padding: 70px 0;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

    .section-heading h2,
    .newsletter h2 {
        font-size: 35px;
    }

    .category-grid {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(4, 270px);
    }

    .product-grid {
        grid-template-columns: 1fr 1fr;
        gap: 25px 12px;
    }

    .product-details {
        flex-direction: column;
        gap: 5px;
    }

    .promotion {
        min-height: 500px;
        padding: 70px 30px;
    }

    .promotion-decoration {
        width: 300px;
        height: 300px;
        right: -100px;
        bottom: -40px;
        top: auto;
        transform: none;
    }

    .newsletter {
        padding: 70px 0;
    }

    .newsletter-form {
        flex-direction: column;
    }

    .footer-inner {
        grid-template-columns: 1fr 1fr;
        gap: 40px 25px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 6px;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 380px) {

    .product-grid {
        grid-template-columns: 1fr;
    }

    .trust-strip {
        grid-template-columns: 1fr;
    }

    .trust-strip > div {
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .trust-strip > div:last-child {
        border-bottom: 0;
    }

}
/* =========================================================
OLATEE SHOP PAGE
========================================================= */

/* =========================================================
SHOP HERO
========================================================= */

.shop-hero {
background: var(--blush);
border-bottom: 1px solid var(--border);
}

.shop-hero-inner {
width: min(100% - 48px, var(--container));
min-height: 300px;
margin: auto;

display: flex;
align-items: center;
justify-content: center;

text-align: center;

}

.shop-hero-inner > div {
max-width: 700px;
}

.shop-hero .eyebrow {
margin-bottom: 10px;
}

.shop-hero h1 {
color: var(--plum);

font-family: Georgia, "Times New Roman", serif;
font-size: clamp(44px, 6vw, 64px);
font-weight: 500;
line-height: 1;
letter-spacing: -2px;

}

.shop-hero p {
max-width: 570px;
margin: 18px auto 0;

color: var(--muted);
font-size: 15px;

}

/* =========================================================
SHOP SECTION
========================================================= */

.shop-section {
width: min(100% - 48px, var(--container));
margin: auto;
padding: 75px 0 100px;
}

.shop-layout {
display: grid;
grid-template-columns: 220px minmax(0, 1fr);
gap: 50px;
}

/* =========================================================
SHOP SIDEBAR
========================================================= */

.shop-sidebar {
align-self: start;
}

.sidebar-header {
padding-bottom: 20px;
border-bottom: 1px solid var(--border);
}

.sidebar-header .eyebrow {
margin-bottom: 5px;
}

.sidebar-header h2 {
color: var(--plum);

font-family: Georgia, "Times New Roman", serif;
font-size: 25px;
font-weight: 500;

}

/* CATEGORY LIST */

.category-list {
padding: 12px 0 28px;
border-bottom: 1px solid var(--border);

display: flex;
flex-direction: column;

}

.category-list a {
min-height: 40px;

display: flex;
align-items: center;
justify-content: space-between;

color: var(--muted);
font-size: 13px;

transition:
    color 0.2s ease,
    padding 0.2s ease;

}

.category-list a span {
color: #a99ba0;
font-size: 10px;
}

.category-list a:hover,
.category-list a.active {
padding-left: 5px;
color: var(--pink-dark);
}

.category-list a.active {
font-weight: 700;
}

/* FILTER GROUP */

.filter-group {
padding: 25px 0;
border-bottom: 1px solid var(--border);
}

.filter-group h3 {
margin-bottom: 15px;

color: var(--plum);

font-size: 12px;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 1px;

}

/* CHECKBOXES */

.checkbox-row {
min-height: 32px;

display: flex;
align-items: center;
gap: 9px;

color: var(--muted);
font-size: 12px;

cursor: pointer;

}

.checkbox-row input {
width: 15px;
height: 15px;

accent-color: var(--pink-dark);

}

/* PRICE INPUTS */

.price-input {
height: 42px;
margin-bottom: 8px;

display: flex;
align-items: center;

border: 1px solid var(--border);
background: white;

}

.price-input span {
padding-left: 11px;

color: var(--muted);
font-size: 12px;

}

.price-input input {
width: 100%;
height: 100%;

padding: 0 10px;

border: 0;
outline: 0;

background: transparent;

color: var(--text);
font-size: 12px;

}

.price-input input::placeholder {
color: #b5a9ad;
}

/* FILTER BUTTON */

.filter-button {
width: 100%;
min-height: 42px;
margin-top: 5px;

border: 1px solid var(--plum);
background: var(--plum);
color: white;

font-size: 11px;
font-weight: 700;

transition:
    background 0.2s ease,
    border-color 0.2s ease;

}

.filter-button:hover {
background: var(--pink-dark);
border-color: var(--pink-dark);
}

/* =========================================================
SHOP TOOLBAR
========================================================= */

.shop-toolbar {
min-height: 48px;
margin-bottom: 28px;

display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;

border-bottom: 1px solid var(--border);

}

.result-count {
color: var(--muted);
font-size: 12px;
}

.result-count strong {
color: var(--plum);
}

.shop-controls {
display: flex;
align-items: center;
gap: 12px;
}

/* SORT */

.sort-control {
display: flex;
align-items: center;
gap: 9px;

color: var(--muted);
font-size: 11px;

}

.sort-control select {
min-width: 150px;
height: 38px;

padding: 0 30px 0 12px;

border: 1px solid var(--border);
outline: none;

background: white;
color: var(--plum);

font-size: 11px;
cursor: pointer;

}

.sort-control select:focus {
border-color: var(--pink);
}

/* MOBILE FILTER */

.mobile-filter-button {
display: none;

min-height: 38px;
padding: 0 14px;

border: 1px solid var(--border);
background: white;

color: var(--plum);

font-size: 11px;
font-weight: 700;

}

/* =========================================================
SHOP PRODUCT GRID
========================================================= */

.shop-product-grid {
grid-template-columns: repeat(3, 1fr);
gap: 42px 20px;
}

.shop-product-grid .product-image {
aspect-ratio: 0.82;

transition:
    transform 0.35s ease,
    box-shadow 0.35s ease;

}

.shop-product-grid .product-card:hover .product-image {
transform: translateY(-4px);
box-shadow: var(--shadow);
}

.shop-product-grid .product-card {
overflow: hidden;
}

/* =========================================================
PRODUCT IMAGE PLACEHOLDER VARIATIONS
========================================================= */

.shop-product-grid .product-card:nth-child(1) .product-image {
background: linear-gradient(145deg, #f0cbd4, #dda4b4);
}

.shop-product-grid .product-card:nth-child(2) .product-image {
background: linear-gradient(145deg, #eed8cd, #dcb49e);
}

.shop-product-grid .product-card:nth-child(3) .product-image {
background: linear-gradient(145deg, #e8d9dd, #cdaab6);
}

.shop-product-grid .product-card:nth-child(4) .product-image {
background: linear-gradient(145deg, #f0ded8, #d9b4aa);
}

.shop-product-grid .product-card:nth-child(5) .product-image {
background: linear-gradient(145deg, #ead1d8, #d7a5b4);
}

.shop-product-grid .product-card:nth-child(6) .product-image {
background: linear-gradient(145deg, #eee2d7, #d6bba4);
}

.shop-product-grid .product-card:nth-child(7) .product-image {
background: linear-gradient(145deg, #e4dce0, #c3aab6);
}

.shop-product-grid .product-card:nth-child(8) .product-image {
background: linear-gradient(145deg, #f0d7cf, #d9b09d);
}

/* =========================================================
PAGINATION
========================================================= */

.pagination {
margin-top: 70px;

display: flex;
align-items: center;
justify-content: center;
gap: 7px;

}

.pagination a,
.pagination span {
width: 38px;
height: 38px;

display: grid;
place-items: center;

color: var(--muted);

font-size: 11px;

}

.pagination a {
border: 1px solid var(--border);
background: white;

transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;

}

.pagination a:hover,
.pagination a.active {
border-color: var(--plum);
background: var(--plum);
color: white;
}

.pagination a.disabled {
opacity: 0.35;
pointer-events: none;
}

.pagination-arrow {
font-size: 16px !important;
}

/* =========================================================
SHOP TABLET
========================================================= */

@media (max-width: 1000px) {

.shop-layout {
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 30px;
}

.shop-product-grid {
    grid-template-columns: repeat(2, 1fr);
}

}

/* =========================================================
SHOP MOBILE
========================================================= */

@media (max-width: 700px) {

.shop-hero-inner {
    min-height: 250px;
}

.shop-hero h1 {
    font-size: 44px;
}

.shop-hero p {
    font-size: 13px;
}

.shop-section {
    width: min(100% - 30px, var(--container));
    padding: 55px 0 70px;
}

.shop-layout {
    display: block;
}

.shop-sidebar {
    display: none;
}

.mobile-filter-button {
    display: block;
}

.shop-toolbar {
    align-items: center;
    margin-bottom: 25px;
}

.shop-controls {
    gap: 7px;
}

.sort-control span {
    display: none;
}

.sort-control select {
    min-width: 125px;
}

.shop-product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 35px 12px;
}

.shop-product-grid .product-details {
    padding-top: 12px;
}

.shop-product-grid .product-details h3 {
    font-size: 15px;
}

.shop-product-grid .product-details p {
    font-size: 10px;
}

.shop-product-grid .product-details strong {
    font-size: 12px;
}

.pagination {
    margin-top: 55px;
}

.pagination a,
.pagination span {
    width: 34px;
    height: 34px;
}

}

/* =========================================================
VERY SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

.shop-toolbar {
    align-items: flex-start;
    flex-direction: column;
    padding-bottom: 15px;
}

.shop-controls {
    width: 100%;
    justify-content: space-between;
}

.sort-control {
    flex: 1;
}

.sort-control select {
    width: 100%;
}

} 
/* =========================================================
OLATEE PRODUCT PAGE
========================================================= */

.product-container {
width: min(100% - 48px, var(--container));
margin: auto;
}

/* =========================================================
BREADCRUMB
========================================================= */

.product-breadcrumb {
border-bottom: 1px solid var(--border);
background: white;
}

.product-breadcrumb .product-container {
min-height: 55px;

display: flex;
align-items: center;
gap: 9px;

color: var(--muted);
font-size: 11px;

}

.product-breadcrumb a:hover {
color: var(--pink-dark);
}

/* =========================================================
PRODUCT LAYOUT
========================================================= */

.product-page {
padding: 75px 0 100px;
}

.product-layout {
display: grid;
grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
gap: 70px;
}

/* =========================================================
GALLERY
========================================================= */

.product-gallery {
min-width: 0;
}

.product-main-image {
position: relative;

aspect-ratio: 0.9;

overflow: hidden;

background: var(--blush);

display: grid;
place-items: center;

}

.product-photo-placeholder {
color: rgba(93, 48, 69, 0.3);

font-family: Georgia, serif;
font-size: 40px;
letter-spacing: 7px;

}

.product-main-badge {
position: absolute;
z-index: 2;
top: 18px;
left: 18px;

padding: 7px 10px;

background: white;
color: var(--pink-dark);

font-size: 9px;
font-weight: 800;
letter-spacing: 1px;

}

.product-thumbnails {
margin-top: 12px;

display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 10px;

}

.product-thumbnail {
aspect-ratio: 1;

border: 1px solid var(--border);

background: var(--blush);

color: rgba(93, 48, 69, 0.35);

font-family: Georgia, serif;
font-size: 13px;

transition: border-color 0.2s ease;

}

.product-thumbnail:hover,
.product-thumbnail.active {
border-color: var(--plum);
}

/* =========================================================
PRODUCT INFORMATION
========================================================= */

.product-information {
align-self: center;
}

.product-category {
color: var(--pink-dark);

font-size: 10px;
font-weight: 800;
letter-spacing: 2px;

}

.product-information h1 {
margin-top: 10px;

color: var(--plum);

font-family: Georgia, "Times New Roman", serif;
font-size: clamp(40px, 5vw, 58px);
font-weight: 500;
line-height: 1;
letter-spacing: -2px;

}

/* RATING */

.product-rating {
margin-top: 18px;

display: flex;
align-items: center;
gap: 10px;

}

.stars {
color: var(--pink-dark);
font-size: 12px;
letter-spacing: 2px;
}

.product-rating a {
color: var(--muted);
font-size: 11px;
text-decoration: underline;
}

/* PRICE */

.product-price {
margin-top: 22px;

color: var(--plum);

font-size: 24px;
font-weight: 700;

}

/* DESCRIPTION */

.product-description {
max-width: 550px;
margin-top: 20px;

color: var(--muted);
font-size: 14px;
line-height: 1.8;

}

/* =========================================================
STOCK
========================================================= */

.stock-status {
margin-top: 24px;

display: flex;
align-items: center;
gap: 8px;

color: #507456;
font-size: 12px;
font-weight: 700;

}

.stock-status small {
margin-left: 4px;

color: var(--muted);
font-size: 10px;
font-weight: 400;

}

.stock-dot {
width: 7px;
height: 7px;

border-radius: 50%;
background: #7aa67d;

}

/* DIVIDER */

.product-divider {
height: 1px;
margin: 25px 0;

background: var(--border);

}

/* =========================================================
OPTIONS
========================================================= */

.product-option {
margin-top: 24px;
}

.option-heading {
margin-bottom: 12px;

display: flex;
justify-content: space-between;
gap: 20px;

}

.option-heading strong {
color: var(--plum);
font-size: 12px;
}

.option-heading span {
color: var(--muted);
font-size: 11px;
}

/* LENGTH BUTTONS */

.option-buttons {
display: flex;
flex-wrap: wrap;
gap: 8px;
}

.option-buttons label {
cursor: pointer;
}

.option-buttons input {
position: absolute;
opacity: 0;
}

.option-buttons span {
min-width: 55px;
height: 42px;
padding: 0 12px;

display: grid;
place-items: center;

border: 1px solid var(--border);
background: white;

color: var(--muted);

font-size: 11px;

}

.option-buttons input:checked + span {
border-color: var(--plum);
background: var(--plum);
color: white;
}

/* =========================================================
COLORS
========================================================= */

.color-options {
display: flex;
gap: 12px;
}

.color-options label {
cursor: pointer;
}

.color-options input {
position: absolute;
opacity: 0;
}

.color-swatch {
width: 31px;
height: 31px;

display: block;

border: 3px solid white;
outline: 1px solid var(--border);
border-radius: 50%;

}

.color-options input:checked + .color-swatch {
outline: 2px solid var(--plum);
outline-offset: 2px;
}

.color-swatch.natural-black {
background: #211d1d;
}

.color-swatch.brown {
background: #694638;
}

.color-swatch.burgundy {
background: #6d3044;
}

/* =========================================================
PURCHASE
========================================================= */

.purchase-row {
margin-top: 30px;

display: grid;
grid-template-columns: 125px 1fr;
gap: 10px;

}

.quantity-control {
height: 52px;

display: grid;
grid-template-columns: 34px 1fr 34px;

border: 1px solid var(--border);
background: white;

}

.quantity-control button {
border: 0;
background: transparent;

color: var(--plum);
font-size: 18px;

}

.quantity-control input {
width: 100%;

border: 0;
outline: 0;

background: transparent;

text-align: center;

color: var(--plum);
font-size: 12px;

}

.quantity-control input::-webkit-inner-spin-button,
.quantity-control input::-webkit-outer-spin-button {
appearance: none;
margin: 0;
}

.add-cart-button {
min-height: 52px;

border: 1px solid var(--plum);
background: var(--plum);

color: white;

font-size: 12px;
font-weight: 700;

transition:
    background 0.2s ease,
    border-color 0.2s ease;

}

.add-cart-button:hover {
background: var(--pink-dark);
border-color: var(--pink-dark);
}

/* BUY NOW */

.buy-now-button {
width: 100%;
min-height: 52px;
margin-top: 10px;

border: 1px solid var(--border);
background: white;

color: var(--plum);

font-size: 12px;
font-weight: 700;

}

.buy-now-button:hover {
border-color: var(--plum);
}

/* =========================================================
BENEFITS
========================================================= */

.product-benefits {
margin-top: 35px;

border-top: 1px solid var(--border);

}

.benefit {
min-height: 66px;

display: flex;
align-items: center;
gap: 14px;

border-bottom: 1px solid var(--border);

}

.benefit svg {
width: 20px;
height: 20px;

flex-shrink: 0;

fill: none;
stroke: var(--pink-dark);
stroke-width: 1.5;
stroke-linecap: round;
stroke-linejoin: round;

}

.benefit strong,
.benefit span {
display: block;
}

.benefit strong {
color: var(--plum);
font-size: 11px;
}

.benefit span {
margin-top: 2px;
color: var(--muted);
font-size: 10px;
}

/* =========================================================
PRODUCT DETAILS
========================================================= */

.product-details-section {
padding: 0 0 100px;
}

.details-tabs {
display: flex;
border-bottom: 1px solid var(--border);
}

.details-tab {
position: relative;

padding: 16px 25px;

border: 0;
background: transparent;

color: var(--muted);

font-size: 11px;
font-weight: 700;

}

.details-tab.active {
color: var(--plum);
}

.details-tab.active::after {
content: "";

position: absolute;
left: 0;
right: 0;
bottom: -1px;

height: 2px;

background: var(--pink-dark);

}

.details-content {
max-width: 750px;
padding-top: 40px;
}

.details-content h2 {
color: var(--plum);

font-family: Georgia, serif;
font-size: 32px;
font-weight: 500;

}

.details-content p {
margin-top: 15px;

color: var(--muted);
font-size: 14px;
line-height: 1.8;

}

/* =========================================================
RELATED PRODUCTS
========================================================= */

.related-products {
padding-top: 20px;
}

/* =========================================================
PRODUCT TABLET
========================================================= */

@media (max-width: 900px) {

.product-layout {
    grid-template-columns: 1fr;
    gap: 50px;
}

.product-information {
    max-width: 700px;
}

}

/* =========================================================
PRODUCT MOBILE
========================================================= */

@media (max-width: 600px) {

.product-container {
    width: min(100% - 30px, var(--container));
}

.product-breadcrumb .product-container {
    min-height: 48px;
    overflow: hidden;
    white-space: nowrap;
}

.product-page {
    padding: 35px 0 65px;
}

.product-main-image {
    aspect-ratio: 0.9;
}

.product-information h1 {
    font-size: 42px;
}

.product-description {
    font-size: 13px;
}

.purchase-row {
    grid-template-columns: 105px 1fr;
}

.details-tabs {
    overflow-x: auto;
    white-space: nowrap;
}

.details-tab {
    padding: 15px 18px;
}

.details-content h2 {
    font-size: 28px;
}

}
/* =========================================
   CART PAGE
   ========================================= */

.cart-hero {
    padding: 150px 0 70px;
    background: var(--blush);
    text-align: center;
}

.cart-hero h1 {
    margin: 0 0 14px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
}

.cart-hero p:last-child {
    max-width: 560px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
}

.cart-section {
    padding: 80px 0 100px;
    background: var(--cream);
}

.cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 60px;
    align-items: start;
}

.cart-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
}

.cart-heading h2,
.cart-summary h2 {
    margin: 0;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.6rem;
    font-weight: 500;
}

.cart-heading span {
    color: var(--muted);
    font-size: 0.9rem;
}

.cart-item {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) auto auto;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
}

.cart-item-image {
    min-height: 145px;
}

.cart-item-details {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.product-category {
    margin: 0 0 7px;
    color: var(--pink-dark);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
}

.cart-item-details h3 {
    margin: 0 0 8px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
    font-weight: 500;
}

.cart-item-details h3 a {
    color: var(--plum);
    text-decoration: none;
}

.cart-variant {
    margin: 0 0 15px;
    color: var(--muted);
    font-size: 0.86rem;
}

.remove-item {
    width: fit-content;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    text-decoration: underline;
    cursor: pointer;
}

.remove-item:hover {
    color: var(--plum);
}

.quantity-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    background: var(--white);
}

.quantity-control button {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--plum);
    cursor: pointer;
}

.quantity-control button:hover {
    background: var(--blush);
}

.quantity-control svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
}

.quantity-control input {
    width: 40px;
    height: 38px;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    text-align: center;
    font: inherit;
}

.quantity-control input:focus {
    outline: 2px solid var(--pink);
    outline-offset: -2px;
}

.cart-item-price {
    min-width: 100px;
    color: var(--plum);
    font-size: 1rem;
    font-weight: 700;
    text-align: right;
}


/* Order Summary */

.cart-summary {
    position: sticky;
    top: 100px;
    padding: 30px;
    border: 1px solid var(--border);
    background: var(--white);
    box-shadow: var(--shadow);
}

.cart-summary h2 {
    margin-bottom: 28px;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 17px;
    color: var(--muted);
    font-size: 0.9rem;
}

.summary-line strong {
    color: var(--text);
    font-weight: 600;
}

.summary-line span:last-child {
    text-align: right;
}

.summary-divider {
    height: 1px;
    margin: 25px 0;
    background: var(--border);
}

.summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    color: var(--plum);
}

.summary-total span {
    font-size: 1rem;
}

.summary-total strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
    font-weight: 500;
}

.checkout-button {
    width: 100%;
    text-align: center;
}

.secure-checkout {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin: 17px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
}

.secure-checkout svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
}


/* Continue Shopping */

.continue-shopping {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 25px;
    color: var(--plum);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
}

.continue-shopping svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}


/* Empty Cart */

.empty-cart {
    padding: 70px 20px;
    border: 1px solid var(--border);
    background: var(--white);
    text-align: center;
}

.empty-cart-icon {
    display: grid;
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--blush);
    color: var(--plum);
}

.empty-cart-icon svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
}

.empty-cart h2 {
    margin: 0 0 10px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.8rem;
    font-weight: 500;
}

.empty-cart p {
    margin: 0 0 25px;
    color: var(--muted);
}


/* Cart Benefits */

.cart-benefits {
    padding: 55px 0;
    border-top: 1px solid var(--border);
    background: var(--white);
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.benefit-card {
    display: flex;
    align-items: flex-start;
    gap: 15px;
}

.benefit-card > svg {
    flex: 0 0 auto;
    width: 25px;
    height: 25px;
    fill: none;
    stroke: var(--plum);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.benefit-card h3 {
    margin: 0 0 5px;
    color: var(--plum);
    font-size: 0.92rem;
}

.benefit-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
}


/* Cart Responsive */

@media (max-width: 980px) {

    .cart-layout {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .cart-summary {
        position: static;
        max-width: 600px;
    }

    .benefits-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
}


@media (max-width: 700px) {

    .cart-hero {
        padding: 125px 0 55px;
    }

    .cart-section {
        padding: 55px 0 70px;
    }

    .cart-item {
        grid-template-columns: 90px minmax(0, 1fr);
        gap: 16px;
        align-items: start;
    }

    .cart-item-image {
        grid-row: span 2;
        min-height: 110px;
    }

    .cart-item-details {
        min-width: 0;
    }

    .cart-item-price {
        grid-column: 2;
        min-width: 0;
        text-align: left;
    }

    .cart-item-quantity {
        grid-column: 2;
        grid-row: 3;
    }

    .cart-summary {
        padding: 25px 20px;
    }

    .summary-line {
        align-items: flex-start;
    }

    .benefits-grid {
        gap: 20px;
    }
}


@media (max-width: 480px) {

    .cart-heading h2 {
        font-size: 1.35rem;
    }

    .cart-item {
        grid-template-columns: 75px minmax(0, 1fr);
    }

    .cart-item-image {
        min-height: 95px;
    }

    .cart-item-details h3 {
        font-size: 1.1rem;
    }

    .cart-variant {
        font-size: 0.78rem;
        line-height: 1.5;
    }

    .cart-item-price {
        font-size: 0.95rem;
    }

    .quantity-control button {
        width: 34px;
        height: 34px;
    }

    .quantity-control input {
        width: 34px;
        height: 34px;
    }
}
/* =========================================
   CHECKOUT PAGE
   ========================================= */

.checkout-secure {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.82rem;
}

.checkout-secure svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
}


/* Checkout Hero */

.checkout-hero {
    padding: 145px 0 65px;
    background: var(--blush);
    text-align: center;
}

.checkout-hero h1 {
    margin: 0 0 14px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 500;
    line-height: 1.05;
}

.checkout-hero p:last-child {
    max-width: 570px;
    margin: 0 auto;
    color: var(--muted);
    line-height: 1.7;
}


/* Main Checkout */

.checkout-section {
    padding: 75px 0 100px;
    background: var(--cream);
}

.checkout-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 55px;
    align-items: start;
}


/* Checkout Cards */

.checkout-card {
    margin-bottom: 25px;
    padding: 30px;
    border: 1px solid var(--border);
    background: var(--white);
}

.checkout-card-heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 28px;
}

.checkout-number {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    background: var(--plum);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 700;
}

.checkout-card-heading h2 {
    margin: 0 0 5px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    font-weight: 500;
}

.checkout-card-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
}


/* Forms */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-full {
    grid-column: 1 / -1;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-field label {
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 700;
}

.form-field label span {
    margin-left: 5px;
    color: var(--muted);
    font-weight: 400;
}

.form-field input,
.form-field select,
.form-field textarea {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid var(--border);
    border-radius: 0;
    outline: none;
    background: var(--cream);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    transition: border-color 0.2s ease, background 0.2s ease;
}

.form-field textarea {
    resize: vertical;
    min-height: 100px;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
    color: #a8999f;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    border-color: var(--pink-dark);
    background: var(--white);
}


/* Delivery */

.delivery-options {
    display: grid;
    gap: 12px;
}

.delivery-option {
    display: block;
    cursor: pointer;
}

.delivery-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.delivery-option-content {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px;
    border: 1px solid var(--border);
    background: var(--cream);
    transition: border-color 0.2s ease, background 0.2s ease;
}

.delivery-option input:checked + .delivery-option-content {
    border-color: var(--pink-dark);
    background: var(--blush);
}

.delivery-option-content > span {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.delivery-option-content strong {
    color: var(--plum);
    font-size: 0.86rem;
}

.delivery-option-content small {
    color: var(--muted);
    font-size: 0.76rem;
}


/* Payment */

.payment-options {
    display: grid;
    gap: 12px;
}

.payment-option {
    display: block;
    cursor: pointer;
}

.payment-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.payment-option-content {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px;
    border: 1px solid var(--border);
    background: var(--cream);
    transition: border-color 0.2s ease, background 0.2s ease;
}

.payment-option input:checked + .payment-option-content {
    border-color: var(--pink-dark);
    background: var(--blush);
}

.payment-icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    place-items: center;
    background: var(--white);
    color: var(--plum);
}

.payment-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.payment-option-content > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.payment-option-content strong {
    color: var(--plum);
    font-size: 0.88rem;
}

.payment-option-content small {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
}


/* Terms */

.checkout-terms {
    margin-top: 5px;
}

.checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
    cursor: pointer;
}

.checkbox-label input {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    margin-top: 3px;
    accent-color: var(--plum);
}

.checkbox-label a {
    color: var(--plum);
    font-weight: 600;
}


/* Checkout Summary */

.checkout-summary {
    position: sticky;
    top: 100px;
}

.checkout-summary-inner {
    padding: 30px;
    border: 1px solid var(--border);
    background: var(--white);
    box-shadow: var(--shadow);
}

.checkout-summary h2 {
    margin: 0 0 25px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
    font-weight: 500;
}

.checkout-product {
    display: grid;
    grid-template-columns: 75px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
}

.checkout-product-image {
    min-height: 85px;
}

.checkout-product-details {
    min-width: 0;
}

.checkout-product-details h3 {
    margin: 0 0 5px;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.98rem;
    font-weight: 500;
}

.checkout-product-details p,
.checkout-product-details span {
    display: block;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.75rem;
}

.checkout-product > strong {
    grid-column: 2;
    color: var(--plum);
    font-size: 0.88rem;
}

.checkout-summary-divider {
    height: 1px;
    margin: 23px 0;
    background: var(--border);
}

.checkout-summary-line {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 15px;
    color: var(--muted);
    font-size: 0.82rem;
}

.checkout-summary-line strong {
    color: var(--text);
}

.checkout-summary-line span:last-child {
    text-align: right;
}

.checkout-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--plum);
}

.checkout-total span {
    font-size: 0.95rem;
}

.checkout-total strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
    font-weight: 500;
}

.place-order-button {
    width: 100%;
    margin-top: 25px;
    border: 0;
    cursor: pointer;
}

.checkout-security {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin: 16px 0 20px;
    color: var(--muted);
    font-size: 0.72rem;
    text-align: center;
}

.checkout-security svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
}

.back-to-cart {
    display: block;
    color: var(--plum);
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
}


/* Checkout Responsive */

@media (max-width: 980px) {

    .checkout-layout {
        grid-template-columns: 1fr;
    }

    .checkout-summary {
        position: static;
        order: -1;
    }

    .checkout-summary-inner {
        max-width: 650px;
    }
}


@media (max-width: 700px) {

    .checkout-hero {
        padding: 125px 0 55px;
    }

    .checkout-section {
        padding: 55px 0 70px;
    }

    .checkout-card {
        padding: 23px 18px;
    }

    .form-grid {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .form-full {
        grid-column: auto;
    }

    .delivery-option-content {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .checkout-summary-inner {
        padding: 24px 20px;
    }
}


@media (max-width: 480px) {

    .checkout-secure {
        font-size: 0.72rem;
    }

    .checkout-card-heading {
        gap: 12px;
    }

    .checkout-number {
        width: 30px;
        height: 30px;
        font-size: 0.65rem;
    }

    .checkout-card-heading h2 {
        font-size: 1.2rem;
    }

    .payment-option-content {
        align-items: flex-start;
    }
}
